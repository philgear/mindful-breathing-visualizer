{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "plugins": ["html"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "currentExercise": "writable",
    "audioController": "writable",
    "sessionTimer": "writable",
    "timerDisplay": "writable",
    "instructionsContainer": "writable",
    "AudioController": "readonly",
    "BreathingExercise": "readonly",
    "BoxBreathing": "readonly",
    "DiaphragmaticBreathing": "readonly",
    "AlternateNostrilBreathing": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-inner-declarations": "off"
  }
}
